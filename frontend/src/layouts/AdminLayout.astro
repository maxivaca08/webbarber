---
import '../styles/global.css';
import { apiFetch } from '../utils/api';

interface Props {
  title: string;
  active: string;
  userName: string;
  alerts?: { cat: string; msg: string }[];
}
const { title, active, userName, alerts = [] } = Astro.props;

const notifRes = await apiFetch('/api/admin/notificaciones', Astro.request);
const { reprogramados = 0 } = notifRes.ok ? await notifRes.json() : {};

const icons = {
  dashboard: '<rect x="2.5" y="2.5" width="6" height="6" rx="1.2"/><rect x="11.5" y="2.5" width="6" height="6" rx="1.2"/><rect x="2.5" y="11.5" width="6" height="6" rx="1.2"/><rect x="11.5" y="11.5" width="6" height="6" rx="1.2"/>',
  turnos: '<rect x="2.5" y="4" width="15" height="13" rx="2"/><line x1="2.5" y1="8" x2="17.5" y2="8"/><line x1="6" y1="2" x2="6" y2="5.5"/><line x1="14" y1="2" x2="14" y2="5.5"/>',
  clientes: '<circle cx="7" cy="6.5" r="2.8"/><path d="M2 17c0-3 2.2-5 5-5s5 2 5 5"/><circle cx="14.5" cy="7.5" r="2.2"/><path d="M12.8 12.2c2.4.1 4.2 1.9 4.2 4.8"/>',
  disponibilidad: '<rect x="4" y="3.5" width="12" height="14" rx="2"/><rect x="7" y="2" width="6" height="3" rx="1"/><path d="M7 10.5l2 2 4-4.2"/>',
  pendientes: '<circle cx="10" cy="10" r="7.2"/><path d="M10 6v4l3 2"/>',
};

const navItems = [
  { href: '/admin',               label: 'Dashboard',      icon: icons.dashboard,      key: 'dashboard', badge: 0 },
  { href: '/admin/turnos',        label: 'Turnos',         icon: icons.turnos,         key: 'turnos',    badge: reprogramados },
  { href: '/admin/clientes',      label: 'Clientes',       icon: icons.clientes,       key: 'clientes',  badge: 0 },
  { href: '/admin/disponibilidad',label: 'Disponibilidad', icon: icons.disponibilidad, key: 'disponibilidad', badge: 0 },
  { href: '/admin/pendientes',    label: 'Pendientes',     icon: icons.pendientes,     key: 'pendientes', badge: 0 },
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — BarberStudio</title>
  <slot name="head" />
</head>
<body class="app-body">

<!-- Desktop sidebar -->
<aside class="sidebar">
  <div class="sidebar-logo">
    <div class="sidebar-logo-icon">
      <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M28 30 L70 72" />
        <path d="M70 72 C 76 78, 76 84, 70 84 C 64 84, 62 80, 66 76" />
        <path d="M72 28 L30 70" />
        <g transform="rotate(-45 51 49)">
          <line x1="40" y1="38" x2="40" y2="60" />
          <line x1="46" y1="38" x2="46" y2="60" />
          <line x1="52" y1="38" x2="52" y2="60" />
          <line x1="58" y1="38" x2="58" y2="60" />
          <rect x="38" y="32" width="24" height="7" rx="2" />
        </g>
      </svg>
    </div>
    <h1>BarberStudio</h1>
  </div>

  <div class="sidebar-user-card">
    <div class="sidebar-avatar">🧔</div>
    <div>
      <strong>{userName}</strong>
      <span>Administrador</span>
    </div>
  </div>

  <nav>
    {navItems.map(n => (
      <a href={n.href} class={active === n.key ? 'active' : ''} style="position:relative">
        <span class="nav-icon" set:html={`<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${n.icon}</svg>`} />
        <span>{n.label}</span>
        {n.badge > 0 && (
          <span style="position:absolute;top:6px;right:10px;background:#ef4444;color:#fff;font-size:10px;font-weight:700;border-radius:999px;padding:1px 6px;line-height:16px">
            {n.badge}
          </span>
        )}
      </a>
    ))}
  </nav>

  <div class="sidebar-bottom">
    <a href="/admin/disponibilidad" class="btn-lime sidebar-cta">+ Agregar horarios</a>
    <a href="https://wa.me/5493876319654" target="_blank" rel="noopener" class="sidebar-link">Soporte</a>
    <a href="/logout" class="sidebar-link danger">Cerrar sesión</a>
  </div>
</aside>

<!-- Mobile bottom nav -->
<nav class="bottom-nav">
  {navItems.map(n => (
    <a href={n.href} class={active === n.key ? 'active' : ''} style="position:relative">
      <span class="nav-icon" set:html={`<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${n.icon}</svg>`} />
      <span>{n.label}</span>
      {n.badge > 0 && (
        <span style="position:absolute;top:4px;right:4px;background:#ef4444;color:#fff;font-size:10px;font-weight:700;border-radius:999px;padding:1px 5px;line-height:15px">
          {n.badge}
        </span>
      )}
    </a>
  ))}
  <a href="/logout">
    <span class="nav-icon" set:html={`<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3H4.5a1.5 1.5 0 0 0-1.5 1.5v11A1.5 1.5 0 0 0 4.5 17H7"/><path d="M12.5 14l4-4-4-4"/><line x1="16.3" y1="10" x2="7" y2="10"/></svg>`} />
    <span>Salir</span>
  </a>
</nav>

<main class="main">
  {alerts.length > 0 && (
    <div class="alerts">
      {alerts.map(a => (
        <div class={`alert alert-${a.cat}`}>
          {a.cat === 'success' ? '✅' : a.cat === 'info' ? 'ℹ️' : '⚠️'}
          {a.msg}
        </div>
      ))}
    </div>
  )}
  <slot />
</main>

<slot name="scripts" />
</body>
</html>
