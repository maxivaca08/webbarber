---
import AuthLayout from '../layouts/AuthLayout.astro';
import { apiFetch } from '../utils/api';

// Already logged in?
const meRes = await apiFetch('/api/auth/me', Astro.request);
if (meRes.ok) {
  const u = await meRes.json();
  return Astro.redirect(u.rol === 'admin' ? '/admin' : '/cliente');
}

let alerts: { cat: string; msg: string }[] = [];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const res = await apiFetch('/api/auth/login', Astro.request, {
    method: 'POST',
    body: JSON.stringify({
      email:    form.get('email'),
      password: form.get('password'),
    }),
  });
  const json = await res.json();
  if (json.success) {
    const setCookie = res.headers.get('set-cookie');
    return new Response(null, {
      status: 302,
      headers: {
        Location: json.redirect,
        ...(setCookie ? { 'Set-Cookie': setCookie } : {}),
      },
    });
  }
  alerts = [{ cat: 'danger', msg: json.error ?? 'Error al iniciar sesión.' }];
} else if (new URL(Astro.request.url).searchParams.get('registered') === '1') {
  alerts = [{ cat: 'success', msg: '¡Cuenta creada! Iniciá sesión para reservar tu turno.' }];
}
---
<AuthLayout title="Iniciar sesión" alerts={alerts}>
  <div slot="logo">
    <h1>Iniciar<br />Sesión</h1>
    <p>Ingresa tus credenciales para acceder a tus citas.</p>
  </div>

  <form method="post" autocomplete="on">
    <div class="form-group">
      <label>Correo o Usuario</label>
      <input type="email" name="email" placeholder="tu@email.com" required autofocus />
    </div>
    <div class="form-group">
      <label>Contraseña</label>
      <div class="password-field">
        <input type="password" name="password" id="password" placeholder="••••••••" required />
        <button type="button" class="password-toggle" id="togglePassword" aria-label="Mostrar contraseña">👁</button>
      </div>
    </div>
    <button type="submit" class="btn-lime">
      Iniciar sesión →
    </button>
  </form>

  <div class="auth-footer">
    ¿No tienes una cuenta? <a href="/register">Regístrate</a>
  </div>

  <script>
    const toggle = document.getElementById('togglePassword');
    const pass = document.getElementById('password') as HTMLInputElement | null;
    toggle?.addEventListener('click', () => {
      if (!pass) return;
      pass.type = pass.type === 'password' ? 'text' : 'password';
    });
  </script>
</AuthLayout>
