---
import AuthLayout from '../layouts/AuthLayout.astro';
import { apiFetch } from '../utils/api';

const meRes = await apiFetch('/api/auth/me', Astro.request);
if (meRes.ok) return Astro.redirect('/');

let alerts: { cat: string; msg: string }[] = [];
let formValues: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  formValues = {
    nombre:   String(form.get('nombre') ?? ''),
    apellido: String(form.get('apellido') ?? ''),
    telefono: String(form.get('telefono') ?? ''),
    email:    String(form.get('email') ?? ''),
  };

  const res = await apiFetch('/api/auth/register', Astro.request, {
    method: 'POST',
    body: JSON.stringify({
      ...formValues,
      password:         form.get('password'),
      confirm_password: form.get('confirm_password'),
    }),
  });
  const json = await res.json();
  if (json.success) {
    return new Response(null, { status: 302, headers: { Location: '/login?registered=1' } });
  }
  alerts = [{ cat: 'danger', msg: json.error ?? 'Error al registrarse.' }];
}
---
<AuthLayout title="Crear cuenta" alerts={alerts}>
  <div slot="logo">
    <h1>Crear<br />Cuenta</h1>
    <p>Registrate para reservar tu turno.</p>
  </div>

  <form method="post">
    <div class="form-grid">
      <div class="form-group">
        <label>Nombre *</label>
        <input type="text" name="nombre" value={formValues.nombre ?? ''} required autofocus />
      </div>
      <div class="form-group">
        <label>Apellido *</label>
        <input type="text" name="apellido" value={formValues.apellido ?? ''} required />
      </div>
      <div class="form-group full">
        <label>Teléfono * (con código de área, sin 0 ni 15)</label>
        <input type="tel" name="telefono" value={formValues.telefono ?? ''} placeholder="Ej: 3876319654" required />
      </div>
      <div class="form-group full">
        <label>Correo o Usuario *</label>
        <input type="email" name="email" value={formValues.email ?? ''} required />
      </div>
      <div class="form-group">
        <label>Contraseña *</label>
        <div class="password-field">
          <input type="password" name="password" id="password" required placeholder="Mínimo 6 caracteres" />
          <button type="button" class="password-toggle" id="togglePassword" aria-label="Mostrar contraseña">👁</button>
        </div>
      </div>
      <div class="form-group">
        <label>Confirmar contraseña *</label>
        <div class="password-field">
          <input type="password" name="confirm_password" id="confirmPassword" required placeholder="Repetí la contraseña" />
          <button type="button" class="password-toggle" id="toggleConfirmPassword" aria-label="Mostrar contraseña">👁</button>
        </div>
      </div>
    </div>
    <button type="submit" class="btn-lime">
      Crear cuenta →
    </button>
  </form>

  <div class="auth-footer">
    ¿Ya tienes una cuenta? <a href="/login">Iniciar sesión</a>
  </div>

  <script>
    function wireToggle(btnId: string, inputId: string) {
      const btn = document.getElementById(btnId);
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      btn?.addEventListener('click', () => {
        if (!input) return;
        input.type = input.type === 'password' ? 'text' : 'password';
      });
    }
    wireToggle('togglePassword', 'password');
    wireToggle('toggleConfirmPassword', 'confirmPassword');
  </script>
</AuthLayout>
