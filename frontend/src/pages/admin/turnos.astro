---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { apiFetch } from '../../utils/api';
import { fechaCorta, diaSemana } from '../../utils/format';

const meRes = await apiFetch('/api/auth/me', Astro.request);
if (!meRes.ok) return Astro.redirect('/login');
const user = await meRes.json();
if (user.rol !== 'admin') return Astro.redirect('/cliente');

const url = new URL(Astro.request.url);
let fecha  = url.searchParams.get('fecha') ?? '';
let estado = url.searchParams.get('estado') ?? '';
const hayFiltros = !!(fecha || estado);

let alerts: { cat: string; msg: string }[] = [];

// Marcar reprogramados como vistos al entrar a esta página
await apiFetch('/api/admin/notificaciones/marcar-visto', Astro.request, { method: 'POST' });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = form.get('turno_id');
  const nuevoEstado = form.get('estado');
  const res = await apiFetch(`/api/admin/turnos/${id}/estado`, Astro.request, {
    method: 'POST',
    body: JSON.stringify({ estado: nuevoEstado }),
  });
  const json = await res.json();
  alerts = [{ cat: res.ok ? 'success' : 'danger', msg: json.message ?? json.error ?? '' }];
}

const params = new URLSearchParams();
if (fecha)  params.set('fecha', fecha);
if (estado) params.set('estado', estado);
const res = await apiFetch(`/api/admin/turnos?${params}`, Astro.request);
const { turnos = [] } = res.ok ? await res.json() : {};
---
<AdminLayout title="Turnos" active="turnos" userName={user.nombre} alerts={alerts}>

  <div class="section-header">
    <span class="agenda-icon">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="15" height="13" rx="2"/><line x1="2.5" y1="8" x2="17.5" y2="8"/><line x1="6" y1="2" x2="6" y2="5.5"/><line x1="14" y1="2" x2="14" y2="5.5"/></svg>
    </span>
    <h2>Todos los turnos</h2>
  </div>
  <p class="page-subtitle">Consultá y actualizá el estado de cada turno reservado.</p>

  <div class="filter-bar">
    <form method="get">
      <div class="form-group">
        <label>Fecha</label>
        <input type="date" name="fecha" value={fecha} />
      </div>
      <div class="form-group">
        <label>Estado</label>
        <select name="estado">
          <option value="">Todos</option>
          <option value="reservado"  selected={estado === 'reservado'}>Reservado</option>
          <option value="confirmado" selected={estado === 'confirmado'}>Confirmado</option>
          <option value="completado" selected={estado === 'completado'}>Completado</option>
          <option value="cancelado"  selected={estado === 'cancelado'}>Cancelado</option>
        </select>
      </div>
      <button type="submit" class="btn btn-ghost btn-mono">Filtrar</button>
      <button type="button" class="btn btn-ghost btn-mono" id="btn-limpiar">✕ Limpiar</button>
    </form>
  </div>

  {turnos.length > 0 ? (
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>#</th><th>Fecha</th><th>Horario</th><th>Cliente</th><th>Teléfono</th><th>Estado</th><th>Acción</th></tr>
          </thead>
          <tbody>
            {turnos.map((t: any) => (
              <tr style={t.reprogramado_sin_ver ? 'background:rgba(234,179,8,0.08);border-left:3px solid #eab308' : ''}>
                <td style="color:var(--text-muted)">{t.id}</td>
                <td>
                  <strong>{fechaCorta(t.fecha)}</strong>
                  <span style="color:var(--text-muted);font-size:12px;display:block">{diaSemana(t.fecha)}</span>
                </td>
                <td><strong>{t.hora_inicio}</strong> – {t.hora_fin}</td>
                <td>
                  {t.cliente}
                  <span style="color:var(--text-muted);font-size:12px;display:block">{t.email}</span>
                </td>
                <td>{t.telefono || '—'}</td>
                <td>
                  <span class={`badge badge-${t.estado}`}>{t.estado}</span>
                  {t.reprogramado_sin_ver && (
                    <span style="display:block;font-size:11px;color:#eab308;font-weight:600;margin-top:3px">🔄 Reprogramado</span>
                  )}
                </td>
                <td>
                  <form method="post" style="display:inline-flex;gap:6px;align-items:center">
                    <input type="hidden" name="turno_id" value={t.id} />
                    <select name="estado" style="padding:6px 8px;font-size:12px;min-width:120px;min-height:34px">
                      <option value="reservado"  selected={t.estado === 'reservado'}>Reservado</option>
                      <option value="confirmado" selected={t.estado === 'confirmado'}>Confirmado</option>
                      <option value="completado" selected={t.estado === 'completado'}>Completado</option>
                      <option value="cancelado"  selected={t.estado === 'cancelado'}>Cancelado</option>
                    </select>
                    <button class="icon-btn" title="Guardar estado">
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h9l3 3v9H4z"/><path d="M7 4v4h6V4"/><path d="M6.5 12h7v4h-7z"/></svg>
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ) : (
    <div class="empty-card">
      <div class="empty-icon-wrap" style="margin:0 auto 20px">
        <div class="empty-circle">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="15" height="13" rx="2"/><line x1="2.5" y1="8" x2="17.5" y2="8"/><line x1="6" y1="2" x2="6" y2="5.5"/><line x1="14" y1="2" x2="14" y2="5.5"/></svg>
        </div>
      </div>
      <h4>No hay turnos {hayFiltros ? 'con esos filtros' : 'todavía'}</h4>
      <p>{hayFiltros ? 'Probá cambiando la fecha o el estado seleccionado.' : 'Cuando un cliente reserve un turno, va a aparecer en esta lista.'}</p>
      {hayFiltros && <a href="/admin/turnos" class="btn-lime" style="width:auto;padding:12px 22px;margin:0 auto">Ver todos los turnos</a>}
    </div>
  )}
</AdminLayout>

<script>
document.getElementById('btn-limpiar')?.addEventListener('click', () => {
  const form = document.querySelector('.filter-bar form') as HTMLFormElement;
  (form.querySelector('input[name="fecha"]') as HTMLInputElement).value = '';
  (form.querySelector('select[name="estado"]') as HTMLSelectElement).value = '';
  form.submit();
});
</script>
