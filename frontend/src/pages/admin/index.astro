---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { apiFetch } from '../../utils/api';

const meRes = await apiFetch('/api/auth/me', Astro.request);
if (!meRes.ok) return Astro.redirect('/login');
const user = await meRes.json();
if (user.rol !== 'admin') return Astro.redirect('/cliente');

let alerts: { cat: string; msg: string }[] = [];

// Leer fecha de la URL (GET param) o usar hoy
const urlParams = new URL(Astro.request.url);
const fechaQuery = urlParams.searchParams.get('fecha') ?? '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id        = form.get('turno_id');
  const newEstado = form.get('estado');
  const redir     = form.get('fecha_redir') as string ?? '';
  const endpoint  = newEstado === 'aprobar'
    ? `/api/admin/turnos-pendientes/${id}/aprobar`
    : `/api/admin/turnos/${id}/estado`;
  const body = newEstado === 'aprobar'
    ? {}
    : { estado: newEstado };
  const res  = await apiFetch(endpoint, Astro.request, { method: 'POST', body: JSON.stringify(body) });
  const json = await res.json();
  alerts = [{ cat: res.ok ? 'success' : 'danger', msg: json.message ?? json.error ?? '' }];
  // Redirigir de vuelta a la misma fecha después del POST
  if (res.ok && redir) {
    return Astro.redirect(`/admin?fecha=${redir}`);
  }
}

const apiUrl = fechaQuery ? `/api/admin/dashboard?fecha=${fechaQuery}` : '/api/admin/dashboard';
const dashRes = await apiFetch(apiUrl, Astro.request);
const { stats = {}, agenda = [], proximo = null, proximos = [], fecha: fechaAPI = '', es_hoy: esHoy = true } = dashRes.ok ? await dashRes.json() : {};

const DIAS   = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
const MESES  = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const ahora  = new Date();
const pad = (n: number) => String(n).padStart(2, '0');
// Fecha en hora LOCAL. toISOString() daría UTC y a la noche (Argentina UTC-3)
// adelantaría un día, mostrando "Ayer" sobre la fecha de hoy.
const fmtLocal = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

// Fecha que se está mostrando
const fechaMostrar = fechaAPI ? new Date(fechaAPI + 'T12:00:00') : ahora;
const hoyStr = fmtLocal(ahora);
const anteriorStr = fmtLocal(new Date(fechaMostrar.getTime() - 86400000));
const siguienteStr = fmtLocal(new Date(fechaMostrar.getTime() + 86400000));

const diffDias = Math.round((fechaMostrar.getTime() - new Date(hoyStr + 'T12:00:00').getTime()) / 86400000);
const labelDia = diffDias === 0 ? 'Hoy' : diffDias === 1 ? 'Mañana' : diffDias === -1 ? 'Ayer' : '';

const fechaStr = `${DIAS[fechaMostrar.getDay()]} ${fechaMostrar.getDate()} de ${MESES[fechaMostrar.getMonth()]} de ${fechaMostrar.getFullYear()}`;

const hora = ahora.getHours();
const saludo = hora < 12 ? 'Buenos días' : hora < 19 ? 'Buenas tardes' : 'Buenas noches';

const WA_BARBERO = '5493876319654';

function estadoConfig(estado: string | null) {
  if (!estado) return { icon: '⚪', color: 'var(--text-muted)', bg: 'var(--surface2)', label: 'Libre' };
  const map: Record<string, { icon: string; color: string; bg: string; label: string }> = {
    confirmado: { icon: '🟢', color: '#10b981', bg: 'rgba(16,185,129,.1)', label: 'Confirmado' },
    reservado:  { icon: '🟡', color: '#f59e0b', bg: 'rgba(245,158,11,.1)', label: 'Reservado' },
    pendiente:  { icon: '🟠', color: '#f97316', bg: 'rgba(249,115,22,.1)', label: 'Pend. pago' },
    cancelado:  { icon: '🔴', color: '#ef4444', bg: 'rgba(239,68,68,.1)',  label: 'Cancelado' },
    completado: { icon: '✅', color: '#6b7280', bg: 'rgba(107,114,128,.1)', label: 'Completado' },
  };
  return map[estado] ?? { icon: '⚪', color: 'var(--text-muted)', bg: 'var(--surface2)', label: estado };
}

function fmtTel(tel: string) {
  return tel ? tel.replace(/(\d{3})(\d{3})(\d{4})/, '$1 $2-$3') : '';
}
---
<AdminLayout title="Dashboard" active="dashboard" userName={user.nombre} alerts={alerts}>

  <!-- ── Encabezado ────────────────────────────────────────── -->
  <p class="dash-greeting">{saludo}, {user.nombre} 👋</p>

  <div class="dash-date-row">
    <a href={`/admin?fecha=${anteriorStr}`} class="date-nav-btn" aria-label="Día anterior">‹</a>
    <a href="/admin" class={`date-nav-today${esHoy ? ' is-active' : ''}`}>Hoy</a>
    <h2>{fechaStr}</h2>
    <a href={`/admin?fecha=${siguienteStr}`} class="date-nav-btn" aria-label="Día siguiente">›</a>

    <div class="date-picker-pill">
      <input type="date" id="fecha-picker" value={fechaAPI || hoyStr} />
    </div>
  </div>

  <!-- ── Tarjetas de resumen ───────────────────────────────── -->
  <div class="stats-grid">

    <div class={`stat-card${(stats.confirmados_hoy??0)>0 ? ' accent' : ''}`}>
      <div class="stat-icon"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="6.5" r="2.8"/><path d="M2 17c0-3 2.2-5 5-5s5 2 5 5"/><circle cx="14.5" cy="7.5" r="2.2"/><path d="M12.8 12.2c2.4.1 4.2 1.9 4.2 4.8"/></svg></div>
      <div class="stat-value">{stats.confirmados_hoy ?? 0}</div>
      <div class="stat-label">Confirmados</div>
    </div>

    <div class={`stat-card${(stats.pendientes_hoy??0)>0 ? ' warn' : ''}`}>
      <div class="stat-icon"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7.5"/><path d="M10 6.5v7M12.3 8c-.3-.9-1.1-1.4-2.3-1.4-1.4 0-2.4.7-2.4 1.7 0 1 .9 1.4 2.4 1.7 1.5.3 2.4.8 2.4 1.8 0 1-1 1.7-2.4 1.7-1.2 0-2-.5-2.3-1.4"/></svg></div>
      <div class="stat-value">{stats.pendientes_hoy ?? 0}</div>
      <div class="stat-label">Pendientes</div>
    </div>

    <div class="stat-card">
      <div class="stat-icon"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h10M5 17h10M6 3c0 4 2.5 5.5 4 7 1.5-1.5 4-3 4-7M6 17c0-4 2.5-5.5 4-7 1.5 1.5 4 3 4 7"/></svg></div>
      <div class="stat-value">{stats.libres_hoy ?? 0}</div>
      <div class="stat-label">Libres</div>
    </div>

    <div class={`stat-card${(stats.por_validar??0)>0 ? ' warn' : ''}`}>
      <div class="stat-icon"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5l6 2.3v4.4c0 4-2.6 6.9-6 8.3-3.4-1.4-6-4.3-6-8.3V4.8z"/><path d="M7.3 10.2l1.8 1.8 3.6-3.8"/></svg></div>
      <div class="stat-value">{stats.por_validar ?? 0}</div>
      <div class="stat-label">Por validar</div>
      {(stats.por_validar ?? 0) > 0 && (
        <a href="/admin/pendientes" class="stat-sub" style="color:var(--warning);font-weight:600;text-decoration:none;display:block">Ver →</a>
      )}
    </div>

    <div class="stat-card">
      <div class="stat-icon"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="11" r="6.5"/><path d="M10 8v3l2 1.5"/><path d="M6 3.5L4 5.5M14 3.5l2 2"/></svg></div>
      {proximo ? (
        <>
          <div class="stat-value" style="font-size:22px">{proximo.hora_inicio}</div>
          <div class="stat-sub" style="color:var(--accent);font-weight:600">{proximo.cliente?.split(' ')[0]} · en {proximo.minutos_restantes} min</div>
        </>
      ) : (
        <>
          <div class="stat-value">—</div>
          <div class="stat-label">Sin próximo</div>
        </>
      )}
    </div>

  </div>

  <!-- ── Card: Próximo turno destacado ────────────────────── -->
  {proximo && (
    <div style="background:linear-gradient(135deg,rgba(16,185,129,.15),rgba(16,185,129,.05));border:1px solid rgba(16,185,129,.3);border-radius:14px;padding:20px 24px;margin-bottom:28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
      <div>
        <div style="font-size:11px;font-weight:700;color:#10b981;letter-spacing:.08em;text-transform:uppercase;margin-bottom:6px">⏰ Próximo turno</div>
        <div style="font-size:22px;font-weight:700;margin-bottom:2px">{proximo.cliente}</div>
        <div style="font-size:15px;color:var(--text-muted)">{proximo.hora_inicio} – {proximo.hora_fin}hs</div>
      </div>
      <div style="text-align:right">
        <div style="font-size:32px;font-weight:800;color:#10b981;line-height:1">{proximo.minutos_restantes}'</div>
        <div style="font-size:12px;color:var(--text-muted)">minutos restantes</div>
        {proximo.telefono && (
          <a href={`https://wa.me/549${proximo.telefono.replace(/\D/g,'')}`} target="_blank" rel="noopener"
             style="display:inline-flex;align-items:center;gap:5px;margin-top:8px;background:#25d366;color:#fff;font-size:12px;font-weight:600;padding:5px 12px;border-radius:20px;text-decoration:none">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
        )}
      </div>
    </div>
  )}

  <!-- ── Agenda del día ────────────────────────────────────── -->
  <div class="agenda-header">
    <div class="agenda-title">
      <span class="agenda-icon">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="15" height="13" rx="2"/><line x1="2.5" y1="8" x2="17.5" y2="8"/><line x1="6" y1="2" x2="6" y2="5.5"/><line x1="14" y1="2" x2="14" y2="5.5"/></svg>
      </span>
      <h3>Agenda <span>— {labelDia || fechaStr}</span></h3>
    </div>
    <a href="/admin/disponibilidad" class="agenda-add-link">+ Agregar horarios</a>
  </div>

  {agenda.length === 0 ? (
    <div class="empty-card">
      <div class="empty-icon-wrap">
        <div class="empty-circle">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="15" height="13" rx="2"/><line x1="2.5" y1="8" x2="17.5" y2="8"/><line x1="6" y1="2" x2="6" y2="5.5"/><line x1="14" y1="2" x2="14" y2="5.5"/><line x1="7.5" y1="11" x2="12.5" y2="15"/><line x1="12.5" y1="11" x2="7.5" y2="15"/></svg>
        </div>
        <div class="empty-badge">✕</div>
      </div>
      <h4>No hay horarios cargados para {esHoy ? 'hoy' : (labelDia ? labelDia.toLowerCase() : 'esta fecha')}</h4>
      <p>Configura tu disponibilidad para empezar a recibir turnos de tus clientes.</p>
      <a href="/admin/disponibilidad" class="btn-lime">Gestionar disponibilidad</a>
    </div>
  ) : (
    <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:32px">
      {(agenda as any[]).map((slot: any) => {
        const cfg = estadoConfig(slot.estado);
        const esLibre = !slot.turno_id;
        const esPendPago = slot.estado === 'pendiente';
        const tel = slot.telefono?.replace(/\D/g, '');
        const waLink = tel ? `https://wa.me/549${tel}` : null;

        return (
          <div style={`display:flex;gap:16px;align-items:flex-start`}>

            {/* Hora */}
            <div style="min-width:52px;text-align:right;padding-top:14px">
              <span style="font-size:13px;font-weight:700;color:var(--text-muted)">{slot.hora_inicio}</span>
            </div>

            {/* Línea vertical */}
            <div style="display:flex;flex-direction:column;align-items:center;gap:0;padding-top:18px">
              <div style={`width:10px;height:10px;border-radius:50%;background:${esLibre?'var(--border)':cfg.color};flex-shrink:0`}></div>
              <div style="width:2px;flex:1;background:var(--border);min-height:20px"></div>
            </div>

            {/* Card del slot */}
            <div style={`flex:1;border-radius:12px;padding:12px 16px;margin-bottom:4px;border:1px solid ${esLibre?'var(--border)':cfg.color+'44'};background:${esLibre?'var(--surface2)':cfg.bg};opacity:${slot.estado==='completado'?.6:1}`}>
              {esLibre ? (
                <div style="display:flex;align-items:center;justify-content:space-between">
                  <span style="font-size:14px;color:var(--text-muted);font-style:italic">Horario libre</span>
                  <span style="font-size:18px">⚪</span>
                </div>
              ) : (
                <>
                  {/* Fila principal */}
                  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;flex-wrap:wrap">
                    <div style="flex:1;min-width:0">
                      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                        <span style={`font-size:16px;font-weight:700;color:${cfg.color}`}>{slot.cliente}</span>
                        <span style={`font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px;background:${cfg.bg};color:${cfg.color};border:1px solid ${cfg.color}44`}>
                          {cfg.icon} {cfg.label}
                        </span>
                        {esPendPago && <span style="font-size:11px;color:#f97316;font-weight:600">⚠️ Validar pago</span>}
                      </div>
                      <div style="font-size:12px;color:var(--text-muted);margin-top:3px">
                        {slot.hora_inicio} – {slot.hora_fin}hs
                        {slot.telefono && <span> · 📱 {fmtTel(slot.telefono)}</span>}
                      </div>
                    </div>

                    {/* Acciones */}
                    <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">

                      {/* WhatsApp */}
                      {waLink && (
                        <a href={waLink} target="_blank" rel="noopener"
                           title="Abrir WhatsApp"
                           style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;background:#25d366;color:#fff;border-radius:8px;text-decoration:none;font-size:15px">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                        </a>
                      )}

                      {/* Copiar teléfono */}
                      {slot.telefono && (
                        <button onclick={`navigator.clipboard.writeText('${slot.telefono}');this.textContent='✅';setTimeout(()=>this.textContent='📋',1500)`}
                                title="Copiar teléfono"
                                style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;background:var(--surface3,#374151);border:none;color:var(--text);border-radius:8px;cursor:pointer;font-size:15px">
                          📋
                        </button>
                      )}

                      {/* Aprobar pago (si pendiente) */}
                      {esPendPago && (
                        <form method="post" style="display:inline"
                              onsubmit="return confirm('¿Confirmar que recibiste el pago?')">
                          <input type="hidden" name="turno_id" value={slot.turno_id} />
                          <input type="hidden" name="estado" value="aprobar" />
                          <input type="hidden" name="fecha_redir" value={fechaAPI} />
                          <button class="btn btn-success btn-sm" title="Aprobar pago">✅ Aprobar</button>
                        </form>
                      )}

                      {/* Menú de estado */}
                      {slot.estado !== 'completado' && slot.estado !== 'cancelado' && (
                        <details style="position:relative" class="accion-menu">
                          <summary style="list-style:none;display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;background:var(--surface3,#374151);border-radius:8px;cursor:pointer;font-size:16px">⋯</summary>
                          <div style="position:absolute;right:0;top:36px;background:var(--surface,#111827);border:1px solid var(--border);border-radius:10px;padding:6px;z-index:10;min-width:160px;box-shadow:0 8px 24px rgba(0,0,0,.4)">
                            {slot.estado !== 'confirmado' && (
                              <form method="post">
                                <input type="hidden" name="turno_id" value={slot.turno_id} />
                                <input type="hidden" name="estado" value="confirmado" />
                                <input type="hidden" name="fecha_redir" value={fechaAPI} />
                                <button style="width:100%;text-align:left;background:none;border:none;color:var(--text);padding:8px 12px;border-radius:6px;cursor:pointer;font-size:13px;display:block" onmouseover="this.style.background='var(--surface2)'" onmouseout="this.style.background='none'">
                                  🟢 Marcar confirmado
                                </button>
                              </form>
                            )}
                            {slot.estado !== 'completado' && (
                              <form method="post">
                                <input type="hidden" name="turno_id" value={slot.turno_id} />
                                <input type="hidden" name="estado" value="completado" />
                                <input type="hidden" name="fecha_redir" value={fechaAPI} />
                                <button style="width:100%;text-align:left;background:none;border:none;color:var(--text);padding:8px 12px;border-radius:6px;cursor:pointer;font-size:13px;display:block" onmouseover="this.style.background='var(--surface2)'" onmouseout="this.style.background='none'">
                                  ✅ Marcar completado
                                </button>
                              </form>
                            )}
                            <form method="post" onsubmit="return confirm('¿Cancelar este turno?')">
                              <input type="hidden" name="turno_id" value={slot.turno_id} />
                              <input type="hidden" name="estado" value="cancelado" />
                              <input type="hidden" name="fecha_redir" value={fechaAPI} />
                              <button style="width:100%;text-align:left;background:none;border:none;color:#ef4444;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:13px;display:block" onmouseover="this.style.background='var(--surface2)'" onmouseout="this.style.background='none'">
                                🔴 Cancelar turno
                              </button>
                            </form>
                          </div>
                        </details>
                      )}

                    </div>
                  </div>
                </>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- ── Próximos días ─────────────────────────────────────── -->
  {proximos.length > 0 && (
    <div style="margin-bottom:32px">
      <h3 style="font-size:16px;font-weight:700;margin-bottom:14px;color:var(--text-muted)">📆 Próximos turnos confirmados</h3>
      <div style="display:flex;flex-direction:column;gap:8px">
        {(proximos as any[]).map((t: any) => {
          const dias2  = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
          const fecha2 = new Date(t.fecha + 'T12:00:00');
          const diaLabel = `${dias2[fecha2.getDay()]} ${fecha2.getDate()}/${fecha2.getMonth()+1}`;
          return (
            <div style="display:flex;align-items:center;gap:14px;background:var(--surface2);border-radius:10px;padding:12px 16px;border:1px solid var(--border)">
              <div style="min-width:64px;font-size:12px;color:var(--text-muted);font-weight:600">{diaLabel}</div>
              <div style="font-size:14px;font-weight:700;min-width:48px">{t.hora_inicio}</div>
              <div style="flex:1;font-size:14px">{t.cliente}</div>
              <span style="font-size:11px;background:rgba(16,185,129,.1);color:#10b981;border:1px solid rgba(16,185,129,.3);padding:2px 10px;border-radius:20px;font-weight:600">✅ Confirmado</span>
            </div>
          );
        })}
      </div>
    </div>
  )}

</AdminLayout>

<style>
details.accion-menu[open] summary { background: var(--surface2); }
details.accion-menu summary::-webkit-details-marker { display: none; }
</style>

<script>
document.getElementById('fecha-picker')?.addEventListener('change', (e) => {
  const val = (e.target as HTMLInputElement).value;
  if (val) window.location.href = `/admin?fecha=${val}`;
});
</script>
