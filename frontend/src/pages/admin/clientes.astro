---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { apiFetch } from '../../utils/api';
import { fechaCorta } from '../../utils/format';

const meRes = await apiFetch('/api/auth/me', Astro.request);
if (!meRes.ok) return Astro.redirect('/login');
const user = await meRes.json();
if (user.rol !== 'admin') return Astro.redirect('/cliente');

let alerts: { cat: string; msg: string }[] = [];

const res = await apiFetch('/api/admin/clientes', Astro.request);
const { clientes = [] } = res.ok ? await res.json() : {};
---
<AdminLayout title="Clientes" active="clientes" userName={user.nombre} alerts={alerts}>

  <div class="agenda-header">
    <div class="section-header" style="margin-bottom:0">
      <span class="agenda-icon">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="6.5" r="2.8"/><path d="M2 17c0-3 2.2-5 5-5s5 2 5 5"/><circle cx="14.5" cy="7.5" r="2.2"/><path d="M12.8 12.2c2.4.1 4.2 1.9 4.2 4.8"/></svg>
      </span>
      <h2>Clientes registrados</h2>
    </div>
    <span class="pill">{clientes.length} clientes</span>
  </div>
  <p class="page-subtitle">Buscá clientes y gestioná sus accesos.</p>

  <div class="search-wrap">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8.5" cy="8.5" r="5.5"/><line x1="16" y1="16" x2="12.5" y2="12.5"/></svg>
    <input type="text" id="buscador" placeholder="Buscar por nombre, email o teléfono..." />
  </div>

  {clientes.length > 0 ? (
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th><th>Nombre</th><th>Teléfono</th><th>Email</th>
              <th>Activos</th><th>Total</th><th>Registrado</th><th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {clientes.map((c: any) => (
              <tr>
                <td style="color:var(--text-muted)">{c.id}</td>
                <td><strong>{c.nombre} {c.apellido}</strong></td>
                <td>{c.telefono || '—'}</td>
                <td style="color:var(--text-muted)">{c.email}</td>
                <td>
                  {c.turnos_activos > 0
                    ? <span class="badge badge-confirmado">{c.turnos_activos}</span>
                    : <span style="color:var(--text-muted)">0</span>
                  }
                </td>
                <td>{c.total_turnos}</td>
                <td style="color:var(--text-muted);font-size:12px">
                  {c.creado_en ? fechaCorta(c.creado_en.substring(0, 10)) : '—'}
                </td>
                <td>
                  <button class="btn btn-ghost btn-sm btn-mono btn-reset-pass"
                          data-id={c.id}
                          data-nombre={`${c.nombre} ${c.apellido}`}>
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px"><circle cx="8" cy="8" r="4.5"/><path d="M11.2 11.2L17 17M14 14v3h3"/></svg>
                    Resetear
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ) : (
    <div class="empty-card">
      <div class="empty-icon-wrap" style="margin:0 auto 20px">
        <div class="empty-circle">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="6.5" r="2.8"/><path d="M2 17c0-3 2.2-5 5-5s5 2 5 5"/><circle cx="14.5" cy="7.5" r="2.2"/><path d="M12.8 12.2c2.4.1 4.2 1.9 4.2 4.8"/></svg>
        </div>
      </div>
      <h4>No hay clientes registrados</h4>
      <p>Cuando alguien se registre en la app, va a aparecer en esta lista.</p>
    </div>
  )}
</AdminLayout>

<!-- Modal -->
<div id="modal-reset" class="modal-overlay">
  <div class="modal-card">
    <h3>Resetear contraseña</h3>
    <p class="modal-sub" id="modal-nombre"></p>
    <label>Nueva contraseña temporal</label>
    <input type="text" id="input-nueva-pass" placeholder="Mínimo 6 caracteres" />
    <p class="modal-error" id="modal-error"></p>
    <div class="modal-actions">
      <button class="btn-decline" id="btn-cancelar-reset">Cancelar</button>
      <button class="btn-lime" id="btn-confirmar-reset">Confirmar</button>
    </div>
  </div>
</div>

<script>
// Buscador en tiempo real
document.getElementById('buscador')!.addEventListener('input', (e) => {
  const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
  document.querySelectorAll('tbody tr').forEach((fila) => {
    const texto = fila.textContent?.toLowerCase() ?? '';
    (fila as HTMLElement).style.display = texto.includes(q) ? '' : 'none';
  });
});

let clienteIdActual: number | null = null;

function abrirModal(btn: HTMLElement) {
  clienteIdActual = Number(btn.dataset.id);
  const modal = document.getElementById('modal-reset')!;
  const nombre = document.getElementById('modal-nombre')!;
  const input  = document.getElementById('input-nueva-pass') as HTMLInputElement;
  const err    = document.getElementById('modal-error')!;
  nombre.textContent = `Cliente: ${btn.dataset.nombre}`;
  input.value = '';
  err.style.display = 'none';
  modal.classList.add('is-open');
  setTimeout(() => input.focus(), 50);
}

function cerrarModal() {
  document.getElementById('modal-reset')!.classList.remove('is-open');
  clienteIdActual = null;
}

document.getElementById('modal-reset')!.addEventListener('click', (e) => {
  if (e.target === e.currentTarget) cerrarModal();
});

// Cableado de eventos (los <script> de Astro son módulos: las funciones NO
// quedan en window, así que no se pueden usar con onclick="..." en el HTML).
document.querySelectorAll('.btn-reset-pass').forEach((b) => {
  b.addEventListener('click', () => abrirModal(b as HTMLElement));
});
document.getElementById('btn-cancelar-reset')!.addEventListener('click', cerrarModal);

document.getElementById('btn-confirmar-reset')!.addEventListener('click', async () => {
  const input = document.getElementById('input-nueva-pass') as HTMLInputElement;
  const err   = document.getElementById('modal-error')!;
  const pass  = input.value.trim();

  if (pass.length < 6) {
    err.textContent = 'La contraseña debe tener al menos 6 caracteres.';
    err.style.display = 'block';
    return;
  }

  const btn = document.getElementById('btn-confirmar-reset') as HTMLButtonElement;
  btn.disabled = true;
  btn.textContent = 'Guardando...';

  const res  = await fetch(`/api/admin/clientes/${clienteIdActual}/resetear-password`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ nueva_password: pass }),
  });
  const json = await res.json();

  btn.disabled = false;
  btn.textContent = 'Confirmar';

  if (res.ok && json.success) {
    cerrarModal();
    alert(`✅ Contraseña reseteada. La nueva contraseña temporal es:\n\n"${pass}"\n\nComunicásela al cliente.`);
  } else {
    err.textContent = json.error ?? 'Error al resetear la contraseña.';
    err.style.display = 'block';
  }
});
</script>
