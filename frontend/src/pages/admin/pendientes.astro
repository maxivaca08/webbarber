---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { apiFetch } from '../../utils/api';
import { fechaCorta, diaSemana, today } from '../../utils/format';

const meRes = await apiFetch('/api/auth/me', Astro.request);
if (!meRes.ok) return Astro.redirect('/login');
const user = await meRes.json();
if (user.rol !== 'admin') return Astro.redirect('/cliente');

let alerts: { cat: string; msg: string }[] = [];

if (Astro.request.method === 'POST') {
  const form   = await Astro.request.formData();
  const id     = form.get('id');
  const action = form.get('_action');

  const endpoint = action === 'aprobar'
    ? `/api/admin/turnos-pendientes/${id}/aprobar`
    : `/api/admin/turnos-pendientes/${id}/rechazar`;

  const res  = await apiFetch(endpoint, Astro.request, { method: 'POST' });
  const json = await res.json();
  alerts = [{ cat: res.ok ? 'success' : 'danger', msg: json.message ?? json.error ?? '' }];
}

const dataRes = await apiFetch('/api/admin/turnos-pendientes', Astro.request);
const { pendientes = [], sena_alias = '', sena_monto = 0 } = dataRes.ok ? await dataRes.json() : {};

const hoyStr = today();
const mananaDate = new Date();
mananaDate.setDate(mananaDate.getDate() + 1);
const mananaStr = `${mananaDate.getFullYear()}-${String(mananaDate.getMonth() + 1).padStart(2, '0')}-${String(mananaDate.getDate()).padStart(2, '0')}`;

function turnoLabel(fecha: string, hora: string) {
  if (fecha === hoyStr) return `Hoy, ${hora}hs`;
  if (fecha === mananaStr) return `Mañana, ${hora}hs`;
  return `${diaSemana(fecha)} ${fechaCorta(fecha)}, ${hora}hs`;
}
---
<AdminLayout title="Turnos pendientes" active="pendientes" userName={user.nombre} alerts={alerts}>

  <div class="section-header">
    <span class="agenda-icon">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h10M5 17h10M6 3c0 4 2.5 5.5 4 7 1.5-1.5 4-3 4-7M6 17c0-4 2.5-5.5 4-7 1.5 1.5 4 3 4 7"/></svg>
      </span>
    <h2>Turnos pendientes de verificación</h2>
  </div>
  <p class="page-subtitle">Revisá y verificá las transferencias de seña de los clientes para confirmar sus turnos.</p>

  {pendientes.length > 0 ? (
    <div class="pending-layout">
      <div class="pending-list">
        {(pendientes as any[]).map((t: any) => {
          const archivoNombre = t.comprobante_path ? t.comprobante_path.split('/').pop() : null;
          const comprobanteUrl = archivoNombre ? `/api/admin/comprobante/${archivoNombre}` : null;
          return (
            <div class="pending-card">
              <div class="pending-card-top">
                <span class="label">Cliente</span>
                <span class="amount">${sena_monto.toLocaleString('es-AR')}</span>
              </div>
              <div class="alias-value">{t.cliente}</div>
              <div class="meta-line">
                {t.telefono && <span>📱 {t.telefono}</span>}
                {comprobanteUrl ? (
                  <span>· <a href={comprobanteUrl} target="_blank" rel="noopener">📎 Ver comprobante</a></span>
                ) : (
                  <span>· Sin comprobante adjunto</span>
                )}
              </div>
              <div class="appointment-line">Turno: <strong>{turnoLabel(t.fecha, t.hora_inicio)}</strong></div>

              <div class="pending-card-actions">
                <form method="post" onsubmit="return confirm('¿Rechazar esta solicitud? El horario quedará libre.')">
                  <input type="hidden" name="id" value={t.id} />
                  <input type="hidden" name="_action" value="rechazar" />
                  <button class="btn-decline">Rechazar</button>
                </form>
                <form method="post" style="flex:1" onsubmit="return confirm('¿Confirmar este turno? Verificaste el comprobante de transferencia.')">
                  <input type="hidden" name="id" value={t.id} />
                  <input type="hidden" name="_action" value="aprobar" />
                  <button class="btn-verify"
                          disabled={!comprobanteUrl || undefined}
                          title={!comprobanteUrl ? 'El cliente no adjuntó comprobante' : ''}>
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5l3.5 3.5L16 5.5"/></svg>
                    Verificar
                  </button>
                </form>
              </div>
            </div>
          );
        })}
      </div>

      <aside class="pending-side">
        <div class="side-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="16" height="11" rx="2"/><line x1="2" y1="9" x2="18" y2="9"/></svg>
        </div>
        <h4>Datos de transferencia</h4>
        <p>Verificá que el alias y el monto coincidan con lo declarado por el cliente antes de aprobar.</p>
        <hr />
        <div class="transfer-ref">
          <span class="ref-label">Alias</span>
          <strong>{sena_alias}</strong>
        </div>
        <div class="transfer-ref">
          <span class="ref-label">Monto</span>
          <strong>${sena_monto.toLocaleString('es-AR')}</strong>
        </div>
      </aside>
    </div>
  ) : (
    <div class="empty-card">
      <div class="empty-icon-wrap" style="margin:0 auto 20px">
        <div class="empty-circle">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 10.5l3.5 3.5L15.5 6"/></svg>
        </div>
      </div>
      <h4>Todo al día</h4>
      <p>No hay solicitudes pendientes de verificación. Cuando un cliente reserve un turno y declare haber transferido la seña, aparecerá aquí.</p>
    </div>
  )}
</AdminLayout>
