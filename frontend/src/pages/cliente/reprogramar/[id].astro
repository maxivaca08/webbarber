---
import ClienteLayout from '../../../layouts/ClienteLayout.astro';
import { apiFetch } from '../../../utils/api';
import { fechaLarga, fechaCorta } from '../../../utils/format';

const meRes = await apiFetch('/api/auth/me', Astro.request);
if (!meRes.ok) return Astro.redirect('/login');
const user = await meRes.json();
if (user.rol !== 'cliente') return Astro.redirect('/admin');

const { id } = Astro.params;
let alerts: { cat: string; msg: string }[] = [];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const res = await apiFetch(`/api/cliente/turnos/${id}/reprogramar`, Astro.request, {
    method: 'POST',
    body: JSON.stringify({ disponibilidad_id: form.get('disponibilidad_id') }),
  });
  const json = await res.json();
  if (json.success) {
    return new Response(null, { status: 302, headers: { Location: '/cliente/mis-turnos' } });
  }
  alerts = [{ cat: 'danger', msg: json.error ?? 'Error al reprogramar.' }];
}

const res = await apiFetch(`/api/cliente/turnos/${id}/slots`, Astro.request);
const slotsJson = await res.json();
if (!res.ok) {
  if (res.status === 403) {
    alerts = [{ cat: 'danger', msg: slotsJson.error ?? 'No es posible reprogramar este turno.' }];
  } else {
    return Astro.redirect('/cliente/mis-turnos');
  }
}
const turno = slotsJson.turno ?? null;
const by_date = slotsJson.by_date ?? {};
const dates = Object.keys(by_date).sort();
---
<ClienteLayout title="Reprogramar turno" active="mis-turnos" userName={user.nombre} alerts={alerts}>
  <div class="page-header">
    <h2>🔄 Reprogramar turno</h2>
    <a href="/cliente/mis-turnos" class="btn btn-ghost">← Volver</a>
  </div>

  {turno && (
    <div class="card" style="margin-bottom:24px">
      <div class="card-header">Turno actual</div>
      <div style="padding:16px 20px;display:flex;gap:16px;flex-wrap:wrap">
        <div>
          <div style="font-size:13px;color:var(--text-muted)">Fecha</div>
          <div style="font-weight:600">{fechaCorta(turno.fecha)}</div>
        </div>
        <div>
          <div style="font-size:13px;color:var(--text-muted)">Horario</div>
          <div style="font-weight:600">{turno.hora_inicio} – {turno.hora_fin}hs</div>
        </div>
        <div>
          <div style="font-size:13px;color:var(--text-muted)">Estado</div>
          <span class={`badge badge-${turno.estado}`}>{turno.estado}</span>
        </div>
      </div>
    </div>
  )}

  {!turno ? (
    <div class="empty-state">
      <div class="icon">🔒</div>
      <a href="/cliente/mis-turnos" class="btn btn-ghost">← Volver a mis turnos</a>
    </div>
  ) : dates.length > 0 ? (
    <form method="post" id="reprog-form"
          data-turno-id={id}
          data-old-fecha={fechaLarga(turno.fecha)}
          data-old-hora={turno.hora_inicio}>
      <input type="hidden" name="disponibilidad_id" id="disp-input" />
      <p style="color:var(--text-muted);margin-bottom:16px;font-size:14px">
        Seleccioná el nuevo horario:
      </p>

      {dates.map(fecha => (
        <div class="fecha-block">
          <div class="fecha-header">
            <h3>{fechaLarga(fecha)}</h3>
            <span>{by_date[fecha].length} disponible{by_date[fecha].length !== 1 ? 's' : ''}</span>
          </div>
          <div class="slots-row">
            {by_date[fecha].map((s: any) => (
              <button
                type="button"
                class="slot-btn"
                data-id={s.id}
                data-fecha={fechaLarga(fecha)}
                data-hora={`${s.hora_inicio} – ${s.hora_fin}`}
              >
                <span class="hora">{s.hora_inicio}</span>
                <span class="label">hasta {s.hora_fin}</span>
              </button>
            ))}
          </div>
        </div>
      ))}

      <div class="confirm-bar" id="confirm-bar" style="display:none">
        <p>
          Nuevo turno: <span class="hora-sel" id="conf-fecha">—</span>
          a las <span class="hora-sel" id="conf-hora">—</span>
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
          <button type="button" class="btn btn-ghost" id="btn-deselect">✕ Cambiar</button>
          <button type="button" id="btn-whatsapp"
                  style="display:flex;align-items:center;gap:8px;background:#25d366;color:#fff;font-weight:600;font-size:14px;padding:10px 18px;border-radius:8px;border:none;cursor:pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span id="btn-whatsapp-label">Confirmar y avisar al barbero</span>
          </button>
        </div>
      </div>
    </form>
  ) : (
    <div class="empty-state">
      <div class="icon">📭</div>
      <p>No hay horarios disponibles para reprogramar.</p>
      <a href="/cliente/mis-turnos" class="btn btn-ghost">Volver a mis turnos</a>
    </div>
  )}
</ClienteLayout>

<script>
const buttons   = document.querySelectorAll<HTMLButtonElement>('.slot-btn');
const dispInput = document.getElementById('disp-input') as HTMLInputElement;
const bar       = document.getElementById('confirm-bar') as HTMLElement;
const confFecha = document.getElementById('conf-fecha') as HTMLElement;
const confHora  = document.getElementById('conf-hora') as HTMLElement;
const deselect  = document.getElementById('btn-deselect') as HTMLButtonElement;

buttons.forEach(btn => {
  btn.addEventListener('click', () => {
    buttons.forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    dispInput.value       = btn.dataset.id ?? '';
    confFecha.textContent = btn.dataset.fecha ?? '';
    confHora.textContent  = (btn.dataset.hora ?? '') + 'hs';
    bar.style.display = 'flex';
    bar.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
});
deselect?.addEventListener('click', () => {
  buttons.forEach(b => b.classList.remove('selected'));
  dispInput.value = '';
  bar.style.display = 'none';
});

const form        = document.getElementById('reprog-form')     as HTMLFormElement;
const btnWhatsapp = document.getElementById('btn-whatsapp')     as HTMLButtonElement;
const btnLabel    = document.getElementById('btn-whatsapp-label') as HTMLElement;
const WA_NUMBER   = '5493876319654';

btnWhatsapp?.addEventListener('click', async () => {
  if (btnWhatsapp.disabled) return;
  const dispId = dispInput.value;
  if (!dispId) { alert('Seleccioná un horario.'); return; }

  const turnoId  = form?.dataset.turnoId  ?? '';
  const oldFecha = form?.dataset.oldFecha ?? '';
  const oldHora  = form?.dataset.oldHora  ?? '';
  const newFecha = confFecha?.textContent ?? '';
  const newHora  = confHora?.textContent  ?? '';

  // Abrimos la pestaña de WhatsApp YA, dentro del gesto del click (evita que
  // el navegador la bloquee tras el await y quede en blanco).
  const waWin = window.open('', '_blank');

  btnWhatsapp.disabled = true;
  btnWhatsapp.style.opacity = '0.7';
  if (btnLabel) btnLabel.textContent = 'Enviando...';

  try {
    const res = await fetch(`/api/cliente/turnos/${turnoId}/reprogramar`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ disponibilidad_id: dispId }),
    });
    const json = await res.json();

    if (!res.ok || !json.success) {
      if (waWin) waWin.close();
      btnWhatsapp.disabled = false;
      btnWhatsapp.style.opacity = '1';
      if (btnLabel) btnLabel.textContent = 'Confirmar y avisar al barbero';
      alert(json.error ?? 'No se pudo reprogramar. Intentá de nuevo.');
      return;
    }

    // Reprogramación exitosa → dirigir la pestaña ya abierta a WhatsApp
    const msg = `Hola! Reprogramé mi turno. Lo tenía para el ${oldFecha} a las ${oldHora}hs y lo pasé al ${newFecha} a las ${newHora}. ¡Gracias!`;
    const waUrl = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(msg)}`;
    if (waWin) waWin.location.href = waUrl;
    else window.open(waUrl, '_blank');

    window.location.href = '/cliente/mis-turnos';

  } catch {
    if (waWin) waWin.close();
    btnWhatsapp.disabled = false;
    btnWhatsapp.style.opacity = '1';
    if (btnLabel) btnLabel.textContent = 'Confirmar y avisar al barbero';
    alert('Error de red. Verificá tu conexión e intentá de nuevo.');
  }
});
</script>
