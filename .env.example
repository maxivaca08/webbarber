# ── Copiá este archivo a `.env` y completá los valores ──────────────────────
# (el `.env` real está en .gitignore y NO debe commitearse)

# ── Flask ───────────────────────────────────────────────────────────────────
# Clave para firmar las sesiones. Generá una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Poné 1 solo para desarrollo local. NUNCA en producción.
FLASK_DEBUG=0

# Puerto de la API Flask (el frontend Astro espera 5001 por defecto).
PORT=5001

# Carpeta persistente para la base de datos y los comprobantes.
# En local dejala vacía (usa el directorio del proyecto). En producción
# apuntala al volumen persistente, p. ej. en Railway: DATA_DIR=/data
DATA_DIR=

# Poné 1 cuando la app corra detrás de HTTPS (producción) para marcar la
# cookie de sesión como Secure. En local dejala vacía o en 0.
COOKIE_SECURE=

# ── Admin inicial ───────────────────────────────────────────────────────────
# Se usan solo la primera vez, al crear el admin en una base vacía.
# Si no definís ADMIN_PASSWORD, se genera una temporal y se imprime en consola.
ADMIN_EMAIL=admin@barberapp.com
ADMIN_NOMBRE=Admin
ADMIN_PASSWORD=

# ── Seña por transferencia ──────────────────────────────────────────────────
SENA_ALIAS=josevilte2001
SENA_MONTO=8000

# ── Email (notificaciones de lista de espera) ───────────────────────────────
# Si EMAIL_USER / EMAIL_PASSWORD quedan vacíos, las notificaciones se loguean
# en consola en vez de enviarse.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
APP_URL=http://localhost:4321
